# Environment-specific values (UniFi download URL, Thread USB IDs) -
# never committed, per Terraform's own convention for this file type.
*.tfvars
*.tfvars.json

# Terraform local state/cache - lives on the remote host in this setup
# (~/terraform on incus-01), never in this repo, but excluded regardless.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log

# Isolated gh CLI auth used for public-repo contributions (PRs/issues) under
# a specific GitHub account, kept separate from other gh/git sessions on
# this machine - holds a live token, never committed.
.gh-config-ianlunam/
